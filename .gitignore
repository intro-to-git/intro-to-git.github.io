# v86 9p guest image (generated by tools/v86-build.sh; 2000+ per-file blobs).
# Do NOT commit: host on Cloudflare R2 (see tools/v86-alpine/BUILD.md). For local
# testing they live on disk under public/v86/ and are served by the dev server.
public/v86/rootfs/
public/v86/fs.json

# v86 saved-state snapshot (the "instant boot" state). The .zst is the hosted
# form (fetched + fzstd-decompressed by src/client/js/lab.js); the raw .bin is
# only an instructor intermediate (from the "Save State" button). Both are large
# (~30 MB / ~110 MB) and, like the 9p root, live on R2 — do NOT commit them.
# Compress a saved state with: tools/v86-zstd-state.sh cos3100-state.bin.
public/v86/cos3100-state.bin
public/v86/cos3100-state.bin.zst

